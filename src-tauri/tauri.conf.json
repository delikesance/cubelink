{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cubelink",
  "version": "0.1.0",
  "identifier": "app.cubelink.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "Cubelink", "width": 1280, "height": 720, "minWidth": 960, "minHeight": 600, "decorations": false }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
