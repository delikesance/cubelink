{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cubelink",
  "version": "0.1.0",
  "identifier": "app.cubelink.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "Cubelink", "visible": false, "width": 1280, "height": 720, "minWidth": 960, "minHeight": 600, "decorations": false, "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion" }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "resources": { "../core/resources/cubelink-lan-agent.jar": "cubelink-lan-agent.jar" },
    "targets": ["msi", "appimage"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "windows": { "wix": { "language": "fr-FR" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVEQzYxOThBNEIwNkQ0MjQKUldRazFBWkxpaG5HWFJWS1A5Skg2eWd0NTNBY3Y2U2hiQ0t3ajV5VVF0a0MzR0l0SFJZcWJ4YTMK",
      "endpoints": ["https://github.com/delikesance/cubelink/releases/latest/download/latest.json"]
    }
  }
}
